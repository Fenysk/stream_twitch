{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",

  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/node_modules",
      "!.agent",
      "!.claude/worktrees",
      "!**/dist",
      "!**/.output",
      "!**/*.gen.ts",
      "!tete-south-park",
      "!streamdeck/*.sdPlugin/bin"
    ]
  },

  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",

      "complexity": {
        "noExcessiveCognitiveComplexity": { "level": "error", "options": { "maxAllowedComplexity": 12 } },
        "noUselessCatch": "error",
        "noForEach": "off"
      },

      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUnreachable": "error"
      },

      "suspicious": {
        "noExplicitAny": "error",
        "noEmptyBlockStatements": "error",
        "noDoubleEquals": "error"
      },

      "style": {
        "noNonNullAssertion": "error",
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "conventions": [
              { "selector": { "kind": "typeLike" }, "formats": ["PascalCase"] },
              { "selector": { "kind": "function" }, "formats": ["camelCase"] },
              { "selector": { "kind": "variable" }, "formats": ["camelCase", "CONSTANT_CASE", "PascalCase"] }
            ]
          }
        },
        "useFilenamingConvention": {
          "level": "error",
          "options": { "filenameCases": ["kebab-case", "PascalCase"], "requireAscii": true }
        },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["node:*", "fs", "path", "child_process"],
                "message": "Module système interdit hors de la couche infra. Le usecase déclare un port, infra l'implémente, app câble. (Inversion des dépendances)"
              }
            ]
          }
        }
      }
    }
  },

  "overrides": [
    {
      "includes": ["src/infra/**", "src/app/**", "*.config.ts", "tools/**"],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts"],
      "linter": {
        "rules": {
          "complexity": { "noExcessiveCognitiveComplexity": "off" },
          "style": { "noRestrictedImports": "off" }
        }
      }
    }
  ],

  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },

  "javascript": { "formatter": { "quoteStyle": "double" } },

  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
