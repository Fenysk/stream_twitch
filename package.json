{
  "name": "stream-twitch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node tools/start.mjs",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run --passWithNoTests",
    "prepare": "git config core.hooksPath tools/git-hooks && git config core.longpaths true || exit 0",
    "gate": "node .agent/core/gate.mjs",
    "calibrate": "node .agent/core/calibrate.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^26.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "nitro": "3.0.260903-beta",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "comfy.js": "1.1.29",
    "lucide-react": "^1.55.0",
    "obs-websocket-js": "^5.0.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  }
}
