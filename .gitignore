node_modules/
dist/
.output/
.nitro/
.tanstack/
coverage/
.vite/

# Le fichier .env n'existe que sur le PC.
.env
.env.*
!.env.example

# Les valeurs qu'Alexis règle dans l'interface (settings.json garde les valeurs par défaut) : elles restent sur son PC.
settings.local.json
settings.local.json.tmp

# Les expressions de la tête qu'Alexis enregistre (data/heads/<id>/) : elles restent sur son PC, comme ses réglages.
data/

# Le code construit du plugin Stream Deck et de son panneau (`pnpm streamdeck:build`).
streamdeck/*.sdPlugin/bin/
streamdeck/*.sdPlugin/ui/

# Un worktree par chantier, créé par `tools/worktree.sh` seulement (JOURNAL 2026-10-07).
.claude/worktrees/

*.log
.DS_Store
Thumbs.db
